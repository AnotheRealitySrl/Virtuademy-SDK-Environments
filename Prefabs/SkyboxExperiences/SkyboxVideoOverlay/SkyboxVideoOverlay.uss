/* SkyboxVideoOverlay — video opened from a SkyboxPOI.
   The root is the semi-transparent backdrop (it fills the screen, or the whole panel in VR) and
   blocks clicks to the UI behind it. SkyboxVideoOverlay sizes .video-frame to the video's aspect
   ratio; the surface shows the video's RenderTexture. */

.video-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.75);
}

.video-frame {
    width: 1280px;
    height: 720px;
    background-color: rgb(0, 0, 0);
    border-radius: 12px;
    overflow: hidden;
}

.video-surface {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* ---- Close (X) at the video's top-right ---- */
.video-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 48px;
    height: 48px;
    margin: 0;
    padding: 0;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    border-radius: 24px;
    background-color: rgba(20, 22, 28, 0.7);
    align-items: center;
    justify-content: center;
    transition-property: scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.video-close:hover {
    scale: 1.1 1.1;
    background-color: rgba(20, 22, 28, 0.9);
    border-color: rgb(255, 255, 255);
}

.video-close-bar {
    position: absolute;
    width: 22px;
    height: 3px;
    border-radius: 2px;
    background-color: rgb(255, 255, 255);
}

.video-close-bar--a {
    rotate: 45deg;
}

.video-close-bar--b {
    rotate: -45deg;
}
