/* SkyboxPOI Video — additions on top of SkyboxPOI.uss.
   The media column stacks the image and the "Start video" button; WorldSpacePOIVideoButton hides
   the button (display: none) when the POI has no video. */

.poi-media-column {
    flex-direction: column;
    flex-shrink: 0;
    margin-right: 24px;
    /* Take the full panel height (set by the text column), so the button can sit at the bottom. */
    align-self: stretch;
}

/* The column now carries the spacing the image had in SkyboxPOI.uss. The image fills whatever
   height the button leaves free (height: 100% would resolve against the auto-height column). */
.poi-media-column > .poi-media {
    margin-right: 0;
    height: auto;
    flex-grow: 1;
}

.poi-video-button {
    height: 44px;
    margin: 12px 0 0 0;
    padding: 0 16px;
    border-width: 0;
    border-radius: 22px;
    background-color: rgb(56, 122, 255);
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-text-align: middle-center;
    /* Poppins Bold (.ttf, environments), like the POI title. */
    -unity-font-definition: url("project://database/Packages/com.anotherealitysrl.virtuademy-sdk-environments/Common/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=e171a80107dfead489c1a91386e3118a&type=3#Poppins-Bold");
    transition-property: background-color;
    transition-duration: 0.12s;
}

.poi-video-button:hover {
    background-color: rgb(30, 98, 235);
}

.poi-video-button:active {
    background-color: rgb(20, 80, 200);
}
