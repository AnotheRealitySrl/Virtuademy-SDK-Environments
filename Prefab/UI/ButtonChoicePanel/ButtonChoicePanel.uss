.bcp-panel {
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px;
    background-color: rgba(20, 22, 28, 0.55);
    -unity-font-definition: url("project://database/Packages/com.anotherealitysrl.virtuademy-sdk-environments/Common/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=e77099ee2358c6c40bc8f4dc48c8b53c&type=3#Poppins-Regular");
}

.bcp-header {
    flex-direction: column;
    align-items: center;
    margin-bottom: 24px;
}

.bcp-welcome {
    font-size: 20px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 0;
}

.bcp-title {
    font-size: 46px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Packages/com.anotherealitysrl.virtuademy-sdk-environments/Common/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=e171a80107dfead489c1a91386e3118a&type=3#Poppins-Bold");
    -unity-font-style: normal;
    letter-spacing: 1px;
    margin-bottom: 0;
}

.bcp-subtitle {
    font-size: 22px;
    color: rgb(235, 238, 242);
}

.bcp-scroll {
    max-width: 1040px;
    flex-grow: 0;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
}

.bcp-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    align-items: flex-start;
}

.bcp-card {
    width: 180px;
    height: 220px;
    flex-shrink: 0;
    flex-grow: 0;
    overflow: hidden;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    padding: 12px;
    margin: 10px;
    background-color: rgb(255, 255, 255);
    border-radius: 14px;
    border-width: 3px;
    border-color: rgba(56, 122, 255, 0);
    transform-origin: center;
    transition-property: scale, border-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.bcp-card:hover {
    scale: 1.05 1.05;
    border-color: rgb(56, 122, 255);
    background-color: rgb(255, 255, 255);
}

.bcp-card:active {
    scale: 1.02 1.02;
}

.bcp-thumb {
    height: 96px;
    flex-shrink: 0;
    border-radius: 8px;
    margin-bottom: 10px;
    background-color: rgb(206, 211, 217);
}

.bcp-tag {
    color: rgb(56, 122, 255);
    -unity-font-definition: url("project://database/Packages/com.anotherealitysrl.virtuademy-sdk-environments/Common/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=e171a80107dfead489c1a91386e3118a&type=3#Poppins-Bold");
    -unity-font-style: normal;
    -unity-text-align: upper-left;
    letter-spacing: 1px;
    margin-bottom: 4px;
    height: 20px;
    flex-shrink: 0;
    font-size: 13px;
}

.bcp-name {
    color: rgb(28, 32, 40);
    white-space: normal;
    -unity-text-align: upper-left;
    height: 40px;
    flex-shrink: 0;
    -unity-font-definition: url("project://database/Packages/com.anotherealitysrl.virtuademy-sdk-environments/Common/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=e77099ee2358c6c40bc8f4dc48c8b53c&type=3#Poppins-Regular");
    line-height: 40px;
    font-size: 15px;
    margin-top: 0;
    padding-top: 0;
}
