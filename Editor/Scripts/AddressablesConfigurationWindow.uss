/* The header (logo and window name) comes from SDK-Core: VirtuademyWindowHeader. */

/* A scene name in the list: a click shows it in the Project window, a double-click opens it. */
.scene-name:hover {
    color: rgb(88, 166, 255);
}

.section {
    margin: 4px 4px 6px 4px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.35);
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.03);
}

.section-header {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.35);
}

.section-title {
    -unity-font-style: bold;
    font-size: 13px;
    flex-grow: 1;
}

.section-note {
    font-size: 11px;
    color: rgb(150, 150, 150);
    margin-left: 6px;
    margin-right: 6px;
}

.section-notice {
    white-space: normal;
    font-size: 11px;
    color: rgb(230, 160, 70);
    margin: 4px 8px 0 8px;
    display: none;
}

.section-body {
    padding: 4px 6px;
}

.section-bar {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.35);
}

.bar-text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    margin-left: 0;
}

.banner {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    margin: 4px;
    border-radius: 3px;
}

.banner-warning {
    background-color: rgba(230, 160, 40, 0.18);
}

.banner-text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    margin-left: 4px;
}

.row-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    align-self: center;
    margin-right: 4px;
}

.chip {
    font-size: 10px;
    padding: 0 4px;
    margin: 0 2px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(185, 185, 185);
    -unity-text-align: middle-center;
}

.chip-sandbox {
    background-color: rgba(60, 140, 230, 0.4);
    color: rgb(200, 225, 255);
}

.chip-preproduction {
    background-color: rgba(235, 135, 35, 0.4);
    color: rgb(255, 220, 180);
}

.chip-danger {
    background-color: rgba(220, 70, 70, 0.25);
    color: rgb(240, 150, 150);
}

/* A platform toggle. On: filled. Off: transparent with a 1 px outline and the normal text colour, so it reads as a button to click, never as disabled. */
.chip-toggle {
    min-width: 0;
    height: 16px;
    padding: 0 5px;
    margin: 0 1px;
    font-size: 10px;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.7);
    background-color: rgba(0, 0, 0, 0);
    color: var(--unity-colors-default-text);
}

.chip-toggle:hover {
    border-color: rgba(170, 170, 170, 0.95);
    background-color: rgba(128, 128, 128, 0.22);
}

.chip-toggle--on {
    border-color: rgba(80, 140, 230, 0.55);
    background-color: rgba(80, 140, 230, 0.35);
}

.chip-toggle--on:hover {
    border-color: rgba(110, 165, 240, 0.9);
    background-color: rgba(80, 140, 230, 0.5);
}

/* The scene row's default thumbnail (a 32 x 18 preview, or a dashed slot with a plus, painted by the drawer), the Localization chip and the details button. */
.default-slot {
    width: 32px;
    height: 18px;
    margin: 0 3px 0 4px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.5);
    border-radius: 2px;
    background-color: rgba(128, 128, 128, 0.12);
}

.default-slot--empty {
    border-width: 0;
    border-color: rgba(128, 128, 128, 0.9);
}

.default-slot:hover {
    background-color: rgba(128, 128, 128, 0.3);
}

.default-slot-image {
    align-self: stretch;
    flex-grow: 1;
}

.default-slot-plus {
    margin: 0;
    padding: 0;
    font-size: 11px;
    color: rgba(128, 128, 128, 0.95);
    -unity-text-align: middle-center;
}

.default-chip {
    min-width: 0;
    height: 16px;
    padding: 0 5px;
    margin: 0 3px 0 1px;
    font-size: 10px;
    border-width: 0;
    background-color: rgba(128, 128, 128, 0.22);
    color: var(--unity-colors-default-text);
}

.default-chip:hover {
    background-color: rgba(128, 128, 128, 0.38);
}

.default-chip--empty {
    opacity: 0.45;
}

.default-drop {
    border-width: 1px;
    border-color: rgb(80, 140, 230);
    background-color: rgba(80, 140, 230, 0.25);
}

.default-refusal {
    color: rgb(230, 160, 70);
}

.info-button {
    width: 16px;
    height: 16px;
    min-width: 0;
    flex-shrink: 0;
    margin: 0 0 0 4px;
    padding: 0;
    border-radius: 8px;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.muted {
    color: rgb(150, 150, 150);
    font-size: 11px;
}

.dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin: 0 5px 0 2px;
    flex-shrink: 0;
}

.settings-item {
    margin-top: 2px;
    margin-bottom: 2px;
    align-items: center;
    flex-direction: row;
}

.settings-value {
    -unity-font-style: normal;
    flex-shrink: 1;
}

/* The foot of Publish Environments: the way to the Addressables settings window. */
.window-footer {
    flex-direction: row;
    justify-content: flex-end;
    margin: 0 4px 6px 4px;
}

.build-error-item {
    border-width: 1px;
    border-radius: 3px;
    border-color: rgba(0, 0, 0, 0.5);
    margin: 4px 6px;
    padding: 6px;
    align-items: center;
    justify-content: flex-start;
    flex-direction: row;
}

.build-error-item-text {
    white-space: normal;
    flex-shrink: 1;
}
