/* The brand header, as in the setup window: the logo is set from code (its variant depends on the editor skin). */
.window-header {
    align-items: center;
    padding-top: 10px;
    padding-bottom: 6px;
}

.header-logo {
    width: 100%;
    max-width: 280px;
    height: 44px;
    background-size: contain;
}

.header-subtitle {
    margin-top: 2px;
    font-size: 12px;
    color: rgb(150, 150, 150);
}

.section {
    margin: 4px 4px 6px 4px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.35);
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.03);
}

.section-header {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.35);
}

.section-title {
    -unity-font-style: bold;
    font-size: 13px;
    flex-grow: 1;
}

.section-note {
    font-size: 11px;
    color: rgb(150, 150, 150);
    margin-left: 6px;
    margin-right: 6px;
}

.section-notice {
    white-space: normal;
    font-size: 11px;
    color: rgb(230, 160, 70);
    margin: 4px 8px 0 8px;
    display: none;
}

.section-body {
    padding: 4px 6px;
}

.section-bar {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.35);
}

.bar-text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    margin-left: 0;
}

.section-foldout > .unity-foldout__toggle {
    margin: 4px 6px;
    -unity-font-style: bold;
}

.banner {
    flex-direction: row;
    align-items: center;
    padding: 4px 6px;
    margin: 4px;
    border-radius: 3px;
}

.banner-warning {
    background-color: rgba(230, 160, 40, 0.18);
}

.banner-text {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    margin-left: 4px;
}

.row-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    align-self: center;
    margin-right: 4px;
}

.chip {
    font-size: 10px;
    padding: 0 4px;
    margin: 0 2px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.08);
    color: rgb(185, 185, 185);
    -unity-text-align: middle-center;
}

.chip-sandbox {
    background-color: rgba(60, 140, 230, 0.4);
    color: rgb(200, 225, 255);
}

.chip-preproduction {
    background-color: rgba(235, 135, 35, 0.4);
    color: rgb(255, 220, 180);
}

.chip-danger {
    background-color: rgba(220, 70, 70, 0.25);
    color: rgb(240, 150, 150);
}

.chip-toggle {
    min-width: 0;
    height: 16px;
    padding: 0 5px;
    margin: 0 1px;
    font-size: 10px;
    border-width: 0;
    background-color: rgba(255, 255, 255, 0.05);
    color: rgb(120, 120, 120);
}

.chip-toggle--on {
    background-color: rgba(80, 140, 230, 0.35);
    color: rgb(220, 230, 245);
}

.muted {
    color: rgb(150, 150, 150);
    font-size: 11px;
}

.dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin: 0 5px 0 2px;
    flex-shrink: 0;
}

.settings-item {
    margin-top: 2px;
    margin-bottom: 2px;
    align-items: center;
    flex-direction: row;
}

.settings-value {
    -unity-font-style: normal;
    flex-shrink: 1;
}

.settings-group {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin: 0 6px;
}

.settings-foldout {
    flex-grow: 1;
    flex-shrink: 1;
}

.settings-foldout > .unity-foldout__toggle {
    -unity-font-style: bold;
}

.settings-button {
    flex-shrink: 0;
}

.build-error-item {
    border-width: 1px;
    border-radius: 3px;
    border-color: rgba(0, 0, 0, 0.5);
    margin: 4px 6px;
    padding: 6px;
    align-items: center;
    justify-content: flex-start;
    flex-direction: row;
}

.build-error-item-text {
    white-space: normal;
    flex-shrink: 1;
}
