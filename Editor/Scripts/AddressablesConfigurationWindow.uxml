<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Packages/com.anotherealitysrl.virtuademy-sdk-environments/Editor/Scripts/AddressablesConfigurationWindow.uss?fileID=7433441132597879392&amp;guid=515b32a0c8a91b84482ae7efefc66dfe&amp;type=3#AddressablesConfigurationWindow" />
    <engine:ScrollView name="window-scroll">
        <engine:VisualElement name="window-header-slot" />
        <engine:VisualElement name="blocking-banner" class="banner banner-warning" style="display: none;">
            <engine:VisualElement name="blocking-icon" class="row-icon" />
            <engine:Label text="The build settings are not the ones the SDK needs: a build would fail at the end." name="blocking-text" class="banner-text" />
            <engine:Button text="Fix" name="blocking-fix-button" tooltip="Applies the build settings the SDK needs. It resets the project's asset groups to a single default group." />
            <engine:Button text="Details" name="blocking-details-button" tooltip="Opens Addressables settings, where each item says what the SDK expects." />
        </engine:VisualElement>
        <engine:VisualElement name="scenes-section" class="section">
            <engine:VisualElement class="section-header">
                <engine:Label text="Scenes" name="scenes-title" class="section-title" tooltip="Every scene of the project is listed: tick the ones to publish. New scenes appear here on their own, unticked." />
                <engine:Label text="" name="scenes-in-build-label" class="section-note" />
            </engine:VisualElement>
            <engine:VisualElement name="scene-configuration-scriptable" class="section-body" />
            <engine:VisualElement name="excluded-folders-slot" class="section-body" />
            <engine:VisualElement name="build-result-errors">
                <engine:VisualElement name="folder-missing" class="build-error-item">
                    <engine:VisualElement name="folder-missing-icon" class="row-icon" />
                    <engine:Label text="The scene could not be built for one or more platforms. Restart the Editor and build again." name="folder-missing-text" class="build-error-item-text" />
                </engine:VisualElement>
                <engine:VisualElement name="binary-catalog" class="build-error-item">
                    <engine:VisualElement name="binary-catalog-icon" class="row-icon" />
                    <engine:Label text="The build wrote its catalog in the wrong format. Open &lt;i&gt;&quot;Window/Asset Management/Addressables/Settings&quot;&lt;/i&gt;, untick &quot;Enable Json Catalog&quot;, tick it again, save the project and restart the Editor. Then build again." name="binary-catalog-text" class="build-error-item-text" />
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:VisualElement class="section-bar">
                <engine:Label text="" name="build-status-label" class="section-note bar-text" />
                <engine:Button text="Build" name="build-addressables-button" />
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement name="deploy-section" class="section">
            <engine:VisualElement class="section-header">
                <engine:Label text="Publish" name="publish-title" class="section-title" tooltip="One group per connection the project uses: tick its worlds, or its tenant level, to deploy there with that connection's login." />
                <engine:Label text="" name="connections-summary-label" class="section-note" />
                <engine:Button text="Import configuration file..." name="import-configuration-button" tooltip="Imports the file a tenant's Back Office downloads (Download SDK Environments Config) into your encrypted connection store. Nothing is written to the project; the connection gets its group below, where you log in." />
            </engine:VisualElement>
            <engine:Label text="" name="login-status-label" class="section-notice" />
            <engine:VisualElement name="deploy-targets" class="section-body" />
            <engine:VisualElement class="section-bar">
                <engine:Label text="" name="deploy-summary-label" class="section-note bar-text" />
                <engine:Button text="Deploy" name="deploy-button" />
                <engine:Button text="Build &amp; Deploy" name="build-and-deploy-button" />
            </engine:VisualElement>
            <engine:VisualElement name="deploy-errors-slot" />
        </engine:VisualElement>
        <engine:VisualElement name="window-footer" class="window-footer">
            <engine:Button text="Addressables settings..." name="addressables-settings-button" tooltip="The Unity Addressables settings the build relies on, each with what the SDK expects (Virtuademy &gt; Advanced &gt; Addressables settings)." />
        </engine:VisualElement>
    </engine:ScrollView>
</engine:UXML>
