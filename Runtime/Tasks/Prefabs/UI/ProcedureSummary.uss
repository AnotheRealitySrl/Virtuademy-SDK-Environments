/* The procedure summary's scrolling list (ProcedureSummaryPanel): a slim rounded thumb in the theme's action colour on
   a faint rounded track, no arrow buttons, no borders; nothing of Unity's grey default scroller. The colours are the
   theme's tokens, inherited from the panel's root. */

.vd-summary-list .unity-scroller--vertical {
    width: 8px;
    margin-left: 12px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.vd-summary-list .unity-scroller__low-button,
.vd-summary-list .unity-scroller__high-button {
    display: none;
}

.vd-summary-list .unity-scroller--vertical > .unity-scroller__slider {
    margin: 0;
}

.vd-summary-list .unity-scroller--vertical .unity-base-slider__drag-container {
    margin: 0;
}

.vd-summary-list .unity-scroller--vertical .unity-base-slider__tracker {
    left: 0;
    right: 0;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.06);
}

.vd-summary-list .unity-scroller--vertical .unity-base-slider__dragger {
    left: 0;
    width: 8px;
    margin: 0;
    border-width: 0;
    border-radius: 4px;
    background-color: var(--vd-color-action);
}

.vd-summary-list .unity-scroller--vertical .unity-base-slider__dragger-border {
    display: none;
}
