<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Packages/com.anotherealitysrl.virtuademy-sdk-environments/Common/Theme/VirtuademyTokens.uss?fileID=7433441132597879392&amp;guid=2c158d41b539451e93fbbc82b1e1a638&amp;type=3#VirtuademyTokens" />
    <Style src="project://database/Packages/com.anotherealitysrl.virtuademy-sdk-environments/Common/Theme/VirtuademyComponents.uss?fileID=7433441132597879392&amp;guid=26245ff1b5e44829b3690bcbe38b57a8&amp;type=3#VirtuademyComponents" />
    <!-- VirtuademyPanel: icon, title, body, two buttons. Only the buttons are pickable. In world space
         the document size is the panel size, 1 px = 1 mm with the SDK world PanelSettings. -->
    <ui:VisualElement name="root" class="vd-root" picking-mode="Ignore" style="flex-grow: 1; align-items: center; justify-content: center;">
        <ui:VisualElement name="panel" class="vd-panel vd-panel--m" picking-mode="Ignore">
            <ui:VisualElement name="header" class="vd-panel__header" picking-mode="Ignore">
                <ui:VisualElement name="icon" class="vd-panel__icon" picking-mode="Ignore">
                    <ui:Label name="icon-glyph" text="i" class="vd-panel__icon-glyph" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="vd-panel__header-text" picking-mode="Ignore">
                    <ui:Label name="title" text="Title" class="vd-title" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="content" class="vd-panel__content" picking-mode="Ignore">
                <ui:Label name="body" text="Text" class="vd-body" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="actions" class="vd-panel__actions" picking-mode="Ignore">
                <ui:Button name="secondary" text="Back" class="vd-button vd-button--secondary" />
                <ui:Button name="primary" text="Continue" class="vd-button vd-button--primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
