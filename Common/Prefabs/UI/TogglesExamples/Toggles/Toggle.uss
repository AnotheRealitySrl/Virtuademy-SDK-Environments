.toggle-root {
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
    -unity-font-definition: url("project://database/Packages/com.anotherealitysrl.virtuademy-sdk-environments/Common/Fonts/Poppins-Regular.ttf?fileID=12800000&guid=e77099ee2358c6c40bc8f4dc48c8b53c&type=3#Poppins-Regular");
}

.toggle-panel {
    display: none;
    flex-direction: row;
    align-items: flex-start;
    max-width: 560px;
    padding: 24px;
    margin-bottom: 24px;
    background-color: rgb(255, 255, 255);
    border-radius: 24px;
}

.toggle-media {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(232, 233, 235);
    border-radius: 16px;
    -unity-background-scale-mode: scale-and-crop;
    overflow: hidden;
    height: 100%;
    margin-right: 24px;
    width: 275px;
}

.toggle-media-arrow {
    display: none;
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    width: 40px;
    height: 40px;
    padding: 0 0 4px 0;
    margin: 0;
    font-size: 30px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    background-color: rgba(20, 22, 28, 0.6);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    border-radius: 20px;
    transform-origin: center;
    transition-property: scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.toggle-media-arrow:hover {
    scale: 1.1 1.1;
    background-color: rgba(20, 22, 28, 0.6);
    border-color: rgb(255, 255, 255);
}

.toggle-media-arrow--prev {
    left: 8px;
}

.toggle-media-arrow--next {
    right: 8px;
}

.toggle-media-label {
    font-size: 18px;
    color: rgb(70, 74, 80);
    -unity-font-style: bold;
}

.toggle-text {
    flex-direction: column;
    flex-shrink: 1;
    width: 350px;
    max-width: 350px;
}

.toggle-title {
    color: rgb(56, 122, 255);
    -unity-font-definition: url("project://database/Packages/com.anotherealitysrl.virtuademy-sdk-environments/Common/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=e171a80107dfead489c1a91386e3118a&type=3#Poppins-Bold");
    white-space: normal;
    overflow: hidden;
    padding-top: 0;
    padding-bottom: 0;
    margin-bottom: 0;
    margin-top: 0;
    font-size: 22px;
    max-height: 60px;
}

.toggle-body {
    color: rgb(28, 32, 40);
    white-space: normal;
    -unity-text-align: upper-left;
    height: 261px;
    margin-top: 0;
    width: auto;
    letter-spacing: -3px;
    word-spacing: 0;
    -unity-paragraph-spacing: -3px;
    padding-top: 10px;
    font-size: 15px;
}

.toggle-icon {
    width: 54px;
    height: 54px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
    background-color: rgba(20, 22, 28, 0.6);
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    border-radius: 27px;
    transform-origin: center;
    transition-property: scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.toggle-icon:hover {
    scale: 1.1 1.1;
    background-color: rgba(20, 22, 28, 0.6);
    border-color: rgb(255, 255, 255);
}

.toggle-dot {
    width: 16px;
    height: 16px;
    background-color: rgb(255, 255, 255);
    border-radius: 8px;
}

.toggle-dot.toggle-dot--play {
    width: 20px;
    height: 20px;
    background-color: rgba(255, 255, 255, 0);
    background-image: url("project://database/Packages/com.anotherealitysrl.virtuademy-sdk-environments/Common/Prefabs/UI/TogglesExamples/Graphics/Reflectis_Icons_Spritesheet_.png?fileID=-1860801222&guid=70e6442b819a37346bf81cb5a22da56c&type=3#Reflectis_Icons_Spritesheet__play");
    background-size: 200% 200%;
    border-radius: 0;
}

/* Keeps the panel above the toggle button: the button lives in its own document
   (ToggleButton.uxml) at the same spot, so the panel reserves the button's height. */
.toggle-icon-spacer {
    width: 54px;
    height: 54px;
    flex-shrink: 0;
}
