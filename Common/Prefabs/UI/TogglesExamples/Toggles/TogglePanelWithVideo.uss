/* TogglePanelWithVideo — additions on top of Toggle.uss.
   The media column stacks the image and the "Start video" button, wired by a UIToolkitButtonBinder
   to open the toggle's video (VideoOverlay prefab). */

.toggle-media-column {
    flex-direction: column;
    flex-shrink: 0;
    margin-right: 24px;
    /* Take the full panel height (set by the text column), so the button can sit at the bottom. */
    align-self: stretch;
}

/* The column now carries the spacing the image had in Toggle.uss. The image fills whatever
   height the button leaves free (height: 100% would resolve against the auto-height column). */
.toggle-media-column > .toggle-media {
    margin-right: 0;
    height: auto;
    flex-grow: 1;
}

.toggle-video-button {
    height: 44px;
    margin: 12px 0 0 0;
    padding: 0 16px;
    border-width: 0;
    border-radius: 22px;
    background-color: var(--vd-color-action, rgb(0, 110, 245));
    color: var(--vd-color-on-action, rgb(255, 255, 255));
    font-size: 18px;
    -unity-text-align: middle-center;
    /* Poppins Bold (.ttf, environments), like the panel title. */
    -unity-font-definition: url("project://database/Packages/com.anotherealitysrl.virtuademy-sdk-environments/Common/Fonts/Poppins-Bold.ttf?fileID=12800000&guid=e171a80107dfead489c1a91386e3118a&type=3#Poppins-Bold");
    transition-property: background-color;
    transition-duration: 0.12s;
}

.toggle-video-button:hover {
    background-color: var(--vd-color-action, rgb(0, 110, 245));
}

.toggle-video-button:active {
    background-color: var(--vd-color-action, rgb(0, 110, 245));
}
